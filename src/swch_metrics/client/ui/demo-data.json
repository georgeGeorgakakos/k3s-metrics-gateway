  "endpoints": [
   {
    "id": "pods_usage",
    "path": "/pods/usage",
    "source": "metrics.k8s.io",
    "description": "CPU (millicores) and memory (MiB) per pod and container",
    "url": "http://swch-metrics-gateway.swarm-system.svc.cluster.local:8000/pods/usage",
    "available": true
   },
   {
    "id": "pod_usage",
    "path": "/pods/{namespace}/{pod}/usage",
    "source": "metrics.k8s.io",
    "description": "CPU/memory for a single pod",
    "url": "http://swch-metrics-gateway.swarm-system.svc.cluster.local:8000/pods/{namespace}/{pod}/usage",
    "available": true
   },
   {
    "id": "nodes_usage",
    "path": "/nodes/usage",
    "source": "metrics.k8s.io",
    "description": "CPU/memory per node with % of allocatable",
    "url": "http://swch-metrics-gateway.swarm-system.svc.cluster.local:8000/nodes/usage",
    "available": true
   },
   {
    "id": "pods_stats",
    "path": "/pods/stats",
    "source": "kubelet",
    "description": "Per-pod CPU, memory, network, ephemeral storage and volumes",
