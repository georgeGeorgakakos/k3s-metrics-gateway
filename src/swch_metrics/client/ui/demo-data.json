    "available": true
   },
   {
    "id": "cadvisor",
    "path": "/cadvisor?metric={prefix}",
    "source": "kubelet",
    "description": "cAdvisor container metrics across all nodes (throttling, I/O, network)",
    "url": "http://swch-metrics-gateway.swarm-system.svc.cluster.local:8000/cadvisor?metric={prefix}",
    "available": true
   },
   {
    "id": "node_cadvisor",
    "path": "/nodes/{node}/cadvisor",
    "source": "kubelet",
    "description": "cAdvisor metrics of one node",
    "url": "http://swch-metrics-gateway.swarm-system.svc.cluster.local:8000/nodes/{node}/cadvisor",
    "available": true
   },
   {
    "id": "node_resource",
    "path": "/nodes/{node}/resource",
    "source": "kubelet",
    "description": "Kubelet /metrics/resource",
    "url": "http://swch-metrics-gateway.swarm-system.svc.cluster.local:8000/nodes/{node}/resource",
    "available": true
   },
   {
    "id": "node_probes",
    "path": "/nodes/{node}/probes",
    "source": "kubelet",
    "description": "Liveness/readiness/startup probe results",
    "url": "http://swch-metrics-gateway.swarm-system.svc.cluster.local:8000/nodes/{node}/probes",
    "available": true
   },
   {
    "id": "node_kubelet",
    "path": "/nodes/{node}/kubelet",
    "source": "kubelet",
    "description": "Kubelet operational metrics",
    "url": "http://swch-metrics-gateway.swarm-system.svc.cluster.local:8000/nodes/{node}/kubelet",
    "available": true
   },
   {
    "id": "pods_status",
    "path": "/pods/status",
    "source": "core",
    "description": "Phase, node, QoS, restarts, requests/limits",
    "url": "http://swch-metrics-gateway.swarm-system.svc.cluster.local:8000/pods/status",
    "available": true
   },
   {
    "id": "pods_overview",
    "path": "/pods/overview",
    "source": "core",
    "description": "Usage joined with requests/limits (% utilisation)",
    "url": "http://swch-metrics-gateway.swarm-system.svc.cluster.local:8000/pods/overview",
    "available": true
   },
   {
    "id": "events",
