{
 "types": [
  {
   "type": "apiserver_health",
   "title": "API server health",
   "description": "1/0 for API server livez and readyz.",
   "endpoint": "/apiserver/health",
   "default_interval": "30s",
   "params": {},
   "outputs": [
    "apiserver_livez",
    "apiserver_readyz"
   ]
  },
  {
   "type": "cadvisor",
   "title": "cAdvisor container metrics",
   "description": "Any cAdvisor metric by name prefix across all nodes, e.g. container_cpu_cfs_throttled_periods_total. Counters can be converted to per-second rates.",
   "endpoint": "/cadvisor",
   "default_interval": "60s",
   "params": {
    "metric": {
     "type": "string",
     "default": "container_cpu_cfs_throttled_periods_total",
     "description": "Metric name prefix",
     "required": true
    },
    "namespace": {
     "type": "string",
     "default": null,
     "description": "Namespace (empty = all namespaces)",
     "required": false
    },
    "rate": {
     "type": "boolean",
     "default": true,
     "description": "Emit per-second rate for counters (_total)",
     "required": false
    },
    "sum_by_pod": {
     "type": "boolean",
     "default": true,
     "description": "Sum container series per pod",
     "required": false
    }
   },
   "outputs": []
  },
  {
   "type": "events",
   "title": "Kubernetes events",
   "description": "New cluster events since the last poll (e.g. OOMKilled, BackOff, FailedScheduling). Value = event count.",
   "endpoint": "/events",
   "default_interval": "60s",
   "params": {
    "namespace": {
     "type": "string",
     "default": null,
     "description": "Namespace (empty = all namespaces)",
     "required": false
    },
    "type": {
     "type": "string",
     "default": "Warning",
     "description": "Event type",
     "required": false,
     "enum": [
      "Warning",
      "Normal",
      ""
     ]
    },
    "reasons": {
     "type": "list",
     "default": [],
     "description": "Only these reasons (empty = all)",
     "required": false
    }
   },
   "outputs": [
    "k8s_event"
   ]
  },
  {
   "type": "http_json",
   "title": "Generic gateway endpoint",
   "description": "Poll any gateway endpoint returning JSON and map fields to metrics: items_path selects the list, value_field the value, label_fields the labels.",
   "endpoint": "(custom)",
   "default_interval": "60s",
   "params": {
    "path": {
     "type": "string",
     "default": "/nodes/usage",
     "description": "Gateway path",
     "required": true
    },
    "query": {
     "type": "json",
     "default": {},
     "description": "Query parameters as JSON object",
     "required": false
    },
    "items_path": {
     "type": "string",
     "default": "",
     "description": "Dotted path to the list of items ('' = root)",
     "required": false
    },
    "value_field": {
     "type": "string",
     "default": "cpu_pct",
     "description": "Dotted path to the numeric value",
     "required": true
    },
    "metric_name": {
     "type": "string",
     "default": "custom_value",
     "description": "Metric name to emit",
     "required": true
    },
    "label_fields": {
     "type": "list",
     "default": [
      "node"
     ],
     "description": "Fields copied to labels",
     "required": false
    },
    "instance_field": {
     "type": "string",
     "default": "node",
     "description": "Field used as EMS instance",
     "required": false
    }
   },
   "outputs": []
  },
  {
   "type": "node_usage",
   "title": "Node CPU & memory",
   "description": "CPU/memory per node with percentage of allocatable (kubectl top nodes).",
   "endpoint": "/nodes/usage",
   "default_interval": "30s",
   "params": {},
   "outputs": [
    "node_cpu_millicores",
    "node_cpu_pct",
    "node_memory_mib",
    "node_memory_pct"
   ]
  },
  {
   "type": "pod_overview",
   "title": "Pod utilisation vs requests/limits",
   "description": "Usage joined with requests and limits: % of request/limit, restarts and running state per pod.",
   "endpoint": "/pods/overview",
   "default_interval": "60s",
   "params": {
    "namespace": {
     "type": "string",
     "default": null,
     "description": "Namespace (empty = all namespaces)",
     "required": false
    },
    "label_selector": {
     "type": "string",
     "default": null,
     "description": "Label selector, e.g. app=web",
     "required": false
    }
   },
   "outputs": [
    "pod_cpu_pct_of_request",
    "pod_cpu_pct_of_limit",
    "pod_memory_pct_of_request",
    "pod_memory_pct_of_limit",
    "pod_restarts",
    "pod_running"
   ]
  },
  {
   "type": "pod_stats",
   "title": "Pod network, disk & volumes",
   "description": "Kubelet summary per pod: CPU, working-set memory, network rx/tx, ephemeral storage and volume usage.",
   "endpoint": "/pods/stats",
   "default_interval": "60s",
   "params": {
    "namespace": {
     "type": "string",
     "default": null,
     "description": "Namespace (empty = all namespaces)",
     "required": false
    },
    "rate": {
     "type": "boolean",
     "default": true,
     "description": "Convert network byte counters to bytes/second",
     "required": false
    }
   },
   "outputs": [
    "pod_cpu_millicores",
    "pod_memory_working_set_mib",
    "pod_network_rx_bytes_per_sec",
    "pod_network_tx_bytes_per_sec",
    "pod_network_rx_bytes_total",
    "pod_network_tx_bytes_total",
    "pod_ephemeral_storage_used_mib",
    "pod_volume_used_mib",
    "pod_volume_used_pct"
   ]
  },
  {
   "type": "pod_usage",
   "title": "Pod CPU & memory",
   "description": "Current CPU (millicores) and memory (MiB) per pod from metrics-server (kubectl top pods).",
   "endpoint": "/pods/usage",
   "default_interval": "30s",
   "params": {
    "namespace": {
     "type": "string",
     "default": null,
     "description": "Namespace (empty = all namespaces)",
     "required": false
    },
    "per_container": {
     "type": "boolean",
     "default": false,
     "description": "Also emit per-container values",
     "required": false
    }
   },
   "outputs": [
    "pod_cpu_millicores",
    "pod_memory_mib",
    "container_cpu_millicores",
    "container_memory_mib"
   ]
  },
  {
   "type": "prometheus",
   "title": "PromQL query",
   "description": "Instant PromQL query through the gateway (requires PROMETHEUS_URL on the gateway).",
   "endpoint": "/prometheus/query",
   "default_interval": "60s",
   "params": {
    "query": {
     "type": "string",
     "default": "sum by (namespace,pod) (rate(container_cpu_usage_seconds_total{container!=\"\"}[5m]))",
     "description": "PromQL expression",
     "required": true
    },
    "name": {
     "type": "string",
     "default": "promql_value",
     "description": "Metric name to emit",
     "required": true
    },
    "instance_label": {
     "type": "string",
     "default": "pod",
     "description": "Label used as EMS instance",
     "required": false
    }
   },
   "outputs": []
  },
  {
   "type": "topology",
   "title": "Cluster topology",
   "description": "Cluster identity, nodes, zones and endpoint catalog. Emits node readiness numbers every poll and the full topology document (topic <prefix>topology) whenever it changes.",
   "endpoint": "/topology",
   "default_interval": "2m",
   "params": {
    "publish_document": {
     "type": "boolean",
     "default": true,
     "description": "Publish the full JSON document on change",
     "required": false
    }
   },
   "outputs": [
    "cluster_nodes_total",
    "cluster_nodes_ready",
    "node_ready",
    "topology"
   ]
  }
 ],
 "sink_types": [
  {
   "type": "ems_stomp",
   "title": "EMS broker (STOMP)",
   "description": "Publish to the EMS broker topics so EMS/EPM can use the metrics in its metric model and SLOs.",
   "options": {
    "host": {
     "type": "string",
     "default": "localhost",
     "description": "Broker host (localhost when running as EMS sidecar)",
     "required": false
    },
    "port": {
     "type": "integer",
     "default": 61610,
     "description": "STOMP port",
     "required": false
    },
    "username": {
     "type": "string",
     "default": "",
     "description": "Broker username",
     "required": false
    },
    "password": {
     "type": "secret",
     "default": "",
     "description": "Broker password",
     "required": false
    },
    "destination": {
     "type": "string",
     "default": "/topic/{metric}",
     "description": "Destination template; placeholders {metric} {collector} {instance}",
     "required": false
    },
    "body_format": {
     "type": "string",
     "default": "ems_event",
     "description": "Message body",
     "required": false,
     "enum": [
      "ems_event",
      "json",
      "headers_only"
     ]
    },
    "level": {
     "type": "integer",
     "default": 1,
     "description": "EMS event level",
     "required": false
    },
    "include_labels_as_headers": {
     "type": "boolean",
     "default": true,
     "description": "Copy labels as 'label-<name>' headers",
     "required": false
    },
    "heartbeat_ms": {
     "type": "integer",
     "default": 10000,
     "description": "STOMP heart-beat (0 = off)",
     "required": false
    },
    "max_messages_per_batch": {
     "type": "integer",
     "default": 5000,
     "description": "Safety cap per collection cycle",
     "required": false
    }
   }
  },
  {
   "type": "jsonl",
   "title": "JSONL archive",
   "description": "Append samples to a JSON-lines file with size-based rotation.",
   "options": {
    "path": {
     "type": "string",
     "default": "/data/metrics.jsonl",
     "description": "File path",
     "required": false
    },
    "max_mb": {
     "type": "integer",
     "default": 50,
     "description": "Rotate when larger than this (MiB)",
     "required": false
    }
   }
  },
  {
   "type": "log",
   "title": "Container log",
   "description": "Write samples to the container log (kubectl logs). Useful for debugging.",
   "options": {
    "max_lines": {
     "type": "integer",
     "default": 20,
     "description": "Max lines per batch (0 = all)",
     "required": false
    }
   }
  },
  {
   "type": "webhook",
   "title": "HTTP webhook",
   "description": "POST each batch as JSON to an HTTP endpoint (e.g. OptimusDB, a data lake ingest, n8n).",
   "options": {
    "url": {
     "type": "string",
     "default": "",
     "description": "Target URL",
     "required": true
    },
    "headers": {
     "type": "json",
     "default": {},
     "description": "Extra HTTP headers",
     "required": false
    },
    "timeout": {
     "type": "integer",
     "default": 10,
     "description": "Timeout (s)",
     "required": false
    }
   }
  }
 ],
 "config": {
  "client_name": "swch-metrics-client",
  "default_interval": "30s",
  "metric_prefix": "swch_k3s_",
  "labels": {
   "swarm_id": "${SWARM_ID:-}",
   "cluster": "${CLUSTER_NAME:-}",
   "cloud": "${CLOUD:-}",
   "region": "${REGION:-}",
   "zone": "${ZONE:-}"
  },
  "gateway": {
   "url": "${GATEWAY_URL:-http://swch-metrics-gateway.swarm-system.svc.cluster.local:8000}",
   "api_key": "${GATEWAY_API_KEY:-}",
   "timeout": 10
  },
  "ui": {
   "enabled": true,
   "port": 8090,
   "username": "admin",
   "password": "${UI_PASSWORD:-}"
  },
  "persist": {
   "mode": "gateway",
   "path": "/data/client.yaml"
  },
  "sinks": [
   {
    "id": "ems",
    "type": "ems_stomp",
    "enabled": true,
    "options": {
     "host": "${EMS_BROKER_HOST:-localhost}",
     "port": 61610,
     "username": "${EMS_BROKER_USERNAME:-aaa}",
     "password": "${EMS_BROKER_PASSWORD:-111}",
     "destination": "/topic/{metric}",
     "body_format": "ems_event"
    }
   },
   {
    "id": "log",
    "type": "log",
    "enabled": false,
    "options": {
     "max_lines": 20
    }
   }
  ],
  "collectors": [
   {
    "id": "nodes",
    "type": "node_usage",
    "interval": "30s"
   },
   {
    "id": "pods",
    "type": "pod_usage",
    "interval": "30s",
    "exclude_namespaces": [
     "kube-system"
    ]
   },
   {
    "id": "pod-utilisation",
    "type": "pod_overview",
    "interval": "60s",
    "exclude_namespaces": [
     "kube-system"
    ],
    "metrics": [
     "pod_cpu_pct_of_limit",
     "pod_memory_pct_of_limit",
     "pod_restarts"
    ]
   },
   {
    "id": "warnings",
    "type": "events",
    "interval": "60s",
    "params": {
     "type": "Warning"
    }
   },
   {
    "id": "topology",
    "type": "topology",
    "interval": "2m"
   }
  ]
 },
